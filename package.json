{
	"name": "fami",
	"version": "1.0.13",
	"license": "MIT",
	"description": "Working with cookies shouldn't be complicated or scary.",
	"type": "module",
	"author": "pxseu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pxseu/fami.git"
	},
	"homepage": "https://github.com/pxseu/fami#readme",
	"bugs": {
		"url": "https://github.com/pxseu/fami/issues"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/pxseu"
	},
	"sideEffects": false,
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./kaito": {
			"import": "./dist/kaito.js",
			"require": "./dist/kaito.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"test": "bun test --coverage",
		"t": "bun run test",
		"prepublishOnly": "bun run build && bun run test"
	},
	"keywords": [
		"cookie",
		"cookies",
		"parser",
		"serialize",
		"rfc6265",
		"http",
		"headers"
	],
	"devDependencies": {
		"@types/bun": "latest",
		"tsup": "^8.5.1",
		"typescript": "^5"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"files": [
		"package.json",
		"README.md",
		"dist"
	]
}
