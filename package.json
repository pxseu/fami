{
	"name": "fami",
	"version": "1.0.9",
	"description": "RFC 6265bis-21 compliant cookie parsing and serialization library",
	"type": "module",
	"author": "pxseu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pxseu/fami.git"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./kaito": {
			"import": "./dist/kaito.js",
			"require": "./dist/kaito.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"test": "bun test",
		"prepublishOnly": "bun run build && bun test"
	},
	"keywords": [
		"cookie",
		"cookies",
		"parser",
		"serialize",
		"rfc6265",
		"http",
		"headers"
	],
	"devDependencies": {
		"@types/bun": "latest",
		"tsup": "^8.5.1",
		"typescript": "^5"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"files": [
		"package.json",
		"README.md",
		"dist"
	],
	"bugs": {
		"url": "https://github.com/pxseu/fami/issues"
	}
}
