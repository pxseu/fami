{
	"name": "fami",
	"version": "2.1.0",
	"license": "MIT",
	"description": "Working with cookies shouldn't be complicated or scary.",
	"type": "module",
	"author": "pxseu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pxseu/fami.git",
		"directory": "packages/fami"
	},
	"homepage": "https://github.com/pxseu/fami#readme",
	"bugs": {
		"url": "https://github.com/pxseu/fami/issues"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/pxseu"
	},
	"sideEffects": false,
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./kaito": {
			"import": {
				"types": "./dist/kaito.d.ts",
				"default": "./dist/kaito.js"
			},
			"require": {
				"types": "./dist/kaito.d.cts",
				"default": "./dist/kaito.cjs"
			}
		},
		"./express": {
			"import": {
				"types": "./dist/express.d.ts",
				"default": "./dist/express.js"
			},
			"require": {
				"types": "./dist/express.d.cts",
				"default": "./dist/express.cjs"
			}
		}
	},
	"scripts": {
		"build": "bun --bun tsdown",
		"dev": "bun --bun tsdown --watch ./src",
		"test": "bun test --coverage",
		"typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"t": "bun run test",
		"tc": "bun run typecheck",
		"prepack": "cp ../../README.md ../../LICENSE .",
		"prepublishOnly": "bun run typecheck && bun run build && bun run test"
	},
	"engines": {
		"node": ">=25",
		"bun": ">=1.1.22",
		"deno": ">=2.5.0"
	},
	"keywords": [
		"cookie",
		"cookies",
		"parser",
		"serialize",
		"rfc6265",
		"http",
		"headers"
	],
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/express": "^5.0.6",
		"tsdown": "^0.22.4",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"typescript": "^5 || ^6 || ^7",
		"@types/express": ">=5"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		},
		"@types/express": {
			"optional": true
		}
	},
	"files": [
		"package.json",
		"README.md",
		"LICENSE",
		"dist"
	]
}
